# 이 파일을 .env로 복사한 뒤 값을 바꿔서 사용합니다. .env는 Git에 커밋하지 않습니다.
# 비밀 값 생성 예: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"

# ---- 외부 주소 ----
# 브라우저가 접속하는 Gateway 주소 (Keycloak iss, Callback 주소의 기준)
PUBLIC_BASE_URL=http://localhost:8080
# 인사팀 백오피스 주소 (CORS 허용 Origin, 로그인 후 이동할 주소)
BACKOFFICE_ORIGIN=http://localhost:3000

# ---- PostgreSQL ----
POSTGRES_PASSWORD=change-me
KEYCLOAK_DB_PASSWORD=change-me
EMPLOYEE_DB_PASSWORD=change-me
EMPLOYEE_AUTH_DB_PASSWORD=change-me

# ---- Keycloak ----
# master Realm 관리자 (kcadm.sh 등 관리 작업용, 외부 비공개)
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
# pmart-employees Realm Client Secret
EMPLOYEE_AUTH_CLIENT_SECRET=change-me
EMPLOYEE_AUTH_BOOTSTRAP_CLIENT_SECRET=change-me
EMPLOYEE_SERVICE_CLIENT_SECRET=change-me

# ---- 서비스 간 내부 API ----
INTERNAL_API_KEY=change-me

# ---- IAM 계정 ----
# IAM 계정 ID = 계정명@도메인 (Keycloak 로그인 ID이자 이메일)
IAM_DOMAIN=pmart.test

# ---- 테스트용 인사팀 백오피스 계정 (Employee Auth Service가 부팅 시 생성) ----
# 사번은 인사 정보, IAM 계정 ID가 로그인 ID
HR_TEST_EMPLOYEE_NO=HR000001
HR_TEST_IAM_ID=hr.admin@pmart.test
HR_TEST_PASSWORD=change-me
